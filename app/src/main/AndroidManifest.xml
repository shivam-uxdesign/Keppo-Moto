<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Route recording. Requested contextually when the rider starts a ride. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Keeps recording while the screen is off / another app is in front. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Studio keeps making Reels when the rider leaves the app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Moments (opt-in): short rider-facing clips with sound around notable ride events. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- External mic for moments: Bluetooth mics need the call-audio link and their name. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Optional pop-up HUD over other apps during a ride; asked for with an explanation. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Safety: text emergency contacts after a crash, and show the alert full screen. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Fuel log, only when the rider turns on "Read card SMS at petrol pumps": the amount of a card payment at a pump. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Dual-SIM phones with SMS on "ask every time": find a SIM to send from. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- The alert screen's Call button rings the contact directly. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Tablets without a SIM can still install; the alert just can't text. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- Map tiles only; ride recording never needs the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Keppo Journal: see whether it's installed, and let the "ride saved" signal reach it (Android 11+ package visibility). -->
    <queries>
        <package android:name="com.keppo.journal" />
    </queries>

    <application
        android:name=".RideTrackApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RideTrack">
        <!-- Crash reports start off; CrashReports turns them on once it's settled (consent where needed). -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Keppo Journal (or any app) opens a ride's page: extra "rideId". -->
            <intent-filter>
                <action android:name="com.keppo.action.OPEN_RIDE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Start a ride: widget, app-icon shortcut, Quick Settings tile and Google Assistant (shortcuts.xml). -->
            <intent-filter>
                <action android:name="com.keppo.action.START_RIDE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="keppomoto" android:host="ride" android:path="/start" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Home-screen widgets and their Pause / Resume. -->
        <receiver android:name=".widget.RideWidgetSmall" android:exported="true" android:label="@string/widget_start">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_small_info" />
        </receiver>
        <receiver android:name=".widget.RideWidgetLarge" android:exported="true" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_large_info" />
        </receiver>
        <receiver android:name=".widget.RideWidgetActions" android:exported="false" />
        <!-- The home-screen widgets: before a ride, after a ride, records, the calendar. -->
        <receiver android:name=".widget.BikeWidget" android:exported="true" android:label="@string/hw_bike">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/hw_bike_info" />
        </receiver>
        <receiver android:name=".widget.FilmTodayWidget" android:exported="true" android:label="@string/hw_film">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/hw_film_info" />
        </receiver>
        <receiver android:name=".widget.DaylightWidget" android:exported="true" android:label="@string/hw_daylight">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/hw_daylight_info" />
        </receiver>
        <receiver android:name=".widget.BikeCareWidget" android:exported="true" android:label="@string/hw_care">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/hw_care_info" />
        </receiver>
        <receiver android:name=".widget.LastRideWidget" android:exported="true" android:label="@string/hw_last_ride">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/hw_last_ride_info" />
        </receiver>
        <receiver android:name=".widget.MomentsWidget" android:exported="true" android:label="@string/hw_moments">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/hw_moments_info" />
        </receiver>
        <receiver android:name=".widget.RecordsWidget" android:exported="true" android:label="@string/hw_records">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/hw_records_info" />
        </receiver>
        <receiver android:name=".widget.CalendarWidget" android:exported="true" android:label="@string/hw_calendar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/hw_calendar_info" />
        </receiver>
        <receiver android:name=".widget.HomeWidgetActions" android:exported="false" />

        <!-- Quick Settings: Start ride. -->
        <service
            android:name=".widget.StartRideTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_ride"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Shares ride graphics, and (BETA) ride export ZIPs. Keep when removing the export tool. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>

        <!-- Keppo Journal reads finished rides here (read-only) once the rider allows it in the system file picker. -->
        <provider
            android:name=".journal.RideDocumentsProvider"
            android:authorities="${applicationId}.rides"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- Keppo Journal's one-tap "Connect": asks the rider, then hands the journal a read grant on the shared rides. -->
        <activity
            android:name=".journal.ShareRidesActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.RideTrack.Translucent">
            <intent-filter>
                <action android:name="com.keppo.action.SHARE_RIDES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Keppo Journal asks to delete a ride: Moto confirms, then moves it to Recently deleted. -->
        <activity
            android:name=".journal.DeleteRideActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.RideTrack.Translucent">
            <intent-filter>
                <action android:name="com.keppo.action.DELETE_RIDE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Crash alert: over the lock screen, its own task so it never mixes with the app's back stack. -->
        <activity
            android:name=".safety.CrashAlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.crash"
            android:theme="@style/Theme.RideTrack.Ride" />

        <service
            android:name=".ride.RideRecordingService"
            android:exported="false"
            android:foregroundServiceType="location|camera|microphone" />

        <receiver
            android:name=".fuel.FuelUndoReceiver"
            android:exported="false" />
        <!-- "Filled up at …?" Yes / No, asked as the rider rides away from a pump. -->
        <receiver
            android:name=".fuel.LivePumpReceiver"
            android:exported="false" />
        <!-- The crash alert notification's I'm OK and Send now buttons. -->
        <receiver
            android:name=".safety.CrashAlertActionReceiver"
            android:exported="false" />

        <service
            android:name=".studio.StudioService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaProcessing" />
    </application>
</manifest>
