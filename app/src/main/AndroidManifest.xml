<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Route recording. Requested contextually when the rider starts a ride. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Keeps recording while the screen is off / another app is in front. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Moments (opt-in): short rider-facing clips with sound around notable ride events. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- External mic for moments: Bluetooth mics need the call-audio link and their name. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Optional pop-up HUD over other apps during a ride; asked for with an explanation. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Safety: text emergency contacts after a crash, and show the alert full screen. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Dual-SIM phones with SMS on "ask every time": find a SIM to send from. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- The alert screen's Call button rings the contact directly. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Tablets without a SIM can still install; the alert just can't text. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <!-- Map tiles only; ride recording never needs the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Keppo Journal: see whether it's installed, and let the "ride saved" signal reach it (Android 11+ package visibility). -->
    <queries>
        <package android:name="com.keppo.journal" />
    </queries>

    <application
        android:name=".RideTrackApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RideTrack">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares ride graphics, and (BETA) ride export ZIPs. Keep when removing the export tool. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>

        <!-- Keppo Journal reads finished rides here (read-only) once the rider allows it in the system file picker. -->
        <provider
            android:name=".journal.RideDocumentsProvider"
            android:authorities="${applicationId}.rides"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- Keppo Journal's one-tap "Connect": asks the rider, then hands the journal a read grant on the shared rides. -->
        <activity
            android:name=".journal.ShareRidesActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.RideTrack.Translucent">
            <intent-filter>
                <action android:name="com.keppo.action.SHARE_RIDES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Crash alert: over the lock screen, its own task so it never mixes with the app's back stack. -->
        <activity
            android:name=".safety.CrashAlertActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.crash"
            android:theme="@style/Theme.RideTrack.Ride" />

        <service
            android:name=".ride.RideRecordingService"
            android:exported="false"
            android:foregroundServiceType="location|camera|microphone" />
    </application>
</manifest>
