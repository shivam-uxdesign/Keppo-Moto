<?xml version="1.0" encoding="utf-8"?>
<!-- Widgets: words change with a short fade and a 6% lift (220 ms). -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:interpolator/fast_out_slow_in" android:duration="220">
    <translate android:fromYDelta="6%" android:toYDelta="0%" />
    <alpha android:fromAlpha="0" android:toAlpha="1" />
</set>
