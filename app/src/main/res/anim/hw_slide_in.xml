<?xml version="1.0" encoding="utf-8"?>
<!-- Widgets: the next item slides in from the right (260 ms, no bounce). -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:interpolator="@android:interpolator/fast_out_slow_in" android:duration="260">
    <translate android:fromXDelta="100%" android:toXDelta="0%" />
    <alpha android:fromAlpha="0.4" android:toAlpha="1" />
</set>
