<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FF85858E" android:textSize="11sp" android:letterSpacing="0.08" android:fontFamily="sans-serif-medium" android:maxLines="1" />
        <TextView android:id="@+id/fresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/hw_badge_teal" android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="1dp" android:paddingBottom="1dp" android:text="@string/hw_new" android:textColor="#FF04292A" android:textSize="10sp" android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <TextView android:id="@+id/value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#FFF4F4F5" android:textSize="50sp" android:fontFamily="sans-serif-light" android:maxLines="1" />
    <TextView android:id="@+id/unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF8B8B93" android:textSize="14sp" />
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/context" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF8B8B93" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
