<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/hw_card" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:paddingEnd="12dp">
