<?xml version="1.0" encoding="utf-8"?>
<!-- Small widget (2×1): Start ride with the bike's name; while riding, the time and distance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <FrameLayout
        android:id="@+id/widget_start"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/widget_start">
        <ImageView
            android:id="@+id/widget_start_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_pill" />
        <ImageView
            android:id="@+id/widget_start_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_play" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_start"
            android:textColor="#FFF4F4F5"
            android:textSize="15sp"
            android:textStyle="bold" />
        <Chronometer
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFF4F4F5"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widget_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#FF8B8B93"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
