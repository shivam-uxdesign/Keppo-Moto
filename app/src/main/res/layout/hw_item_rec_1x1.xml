<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
    <TextView android:id="@+id/value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF4F4F5" android:textSize="26sp" android:maxLines="1" />
    <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF85858E" android:textSize="10sp" android:letterSpacing="0.06" android:fontFamily="sans-serif-medium" />
    <TextView android:id="@+id/unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF8B8B93" android:textSize="10sp" />
</LinearLayout>
