<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/hw_card" android:orientation="horizontal" android:padding="12dp">
    <FrameLayout android:layout_width="0dp" android:layout_weight="0.42" android:layout_height="match_parent">
        <ViewFlipper android:id="@+id/flip_photo" android:layout_width="match_parent" android:layout_height="match_parent" android:inAnimation="@anim/hw_slide_in" android:outAnimation="@anim/hw_slide_out" android:contentDescription="@string/hw_switch_bike" />
        <ImageView android:id="@+id/dots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="10dp" android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="0.58" android:layout_height="match_parent" android:layout_marginStart="12dp" android:orientation="vertical">
        <ViewFlipper android:id="@+id/flip_text" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:inAnimation="@anim/hw_fade_in" android:outAnimation="@anim/hw_fade_out" />
        <LinearLayout android:id="@+id/start" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:background="@drawable/hw_pill_white" android:gravity="center" android:orientation="horizontal" android:contentDescription="@string/hw_start_ride">
            <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@drawable/hw_ic_play" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/hw_start_ride" android:textColor="#FF0A0A0B" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
