<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/hw_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
    <ViewFlipper android:id="@+id/flip_photo" android:layout_width="72dp" android:layout_height="match_parent" android:inAnimation="@anim/hw_slide_in" android:outAnimation="@anim/hw_slide_out" android:contentDescription="@string/hw_switch_bike" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="10dp" android:orientation="vertical">
        <ViewFlipper android:id="@+id/flip_text" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:inAnimation="@anim/hw_fade_in" android:outAnimation="@anim/hw_fade_out" />
        <TextView android:id="@+id/start" android:layout_width="match_parent" android:layout_height="34dp" android:background="@drawable/hw_pill_white" android:gravity="center" android:text="@string/hw_start" android:textColor="#FF0A0A0B" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
    </LinearLayout>
</LinearLayout>
