<?xml version="1.0" encoding="utf-8"?>
<!-- TextureView, not the default SurfaceView: it's clipped to the pop-up's rounded square
     like any other view (a SurfaceView draws in its own layer and spills out of the card). -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:resize_mode="zoom"
    app:shutter_background_color="@android:color/black"
    app:surface_type="texture_view"
    app:use_controller="false" />
