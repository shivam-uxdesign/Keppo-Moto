<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/hw_card" android:contentDescription="@string/hw_start_ride">
    <ImageView android:id="@+id/photo" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/ready_dot" android:layout_width="10dp" android:layout_height="10dp" android:layout_gravity="start|bottom" android:layout_margin="12dp" android:src="@drawable/hw_dot" android:importantForAccessibility="no" />
    <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="end|bottom" android:layout_margin="8dp" android:background="@drawable/hw_round_white">
        <ImageView android:layout_width="13dp" android:layout_height="13dp" android:layout_gravity="center" android:src="@drawable/hw_ic_play" android:importantForAccessibility="no" />
    </FrameLayout>
</FrameLayout>
