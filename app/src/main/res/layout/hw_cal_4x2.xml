<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/hw_card" android:orientation="horizontal" android:padding="14dp">
    <LinearLayout android:layout_width="0dp" android:layout_weight="0.64" android:layout_height="match_parent" android:orientation="vertical">
        <ImageView android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitStart" android:importantForAccessibility="no" />
        <TextView android:id="@+id/months" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FF85858E" android:textSize="10sp" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="0.36" android:layout_height="match_parent" android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hw_13_weeks" android:textColor="#FF85858E" android:textSize="11sp" android:letterSpacing="0.08" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#FFF4F4F5" android:textSize="22sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hw_days_ridden" android:textColor="#FF8B8B93" android:textSize="11sp" />
        <TextView android:id="@+id/km" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#FFF4F4F5" android:textSize="22sp" />
        <TextView android:id="@+id/unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF8B8B93" android:textSize="11sp" />
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF69C8CB" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
