<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <TextView android:id="@+id/when" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF8B8B93" android:textSize="12sp" android:maxLines="1" />
    <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFF4F4F5" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/km" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF4F4F5" android:textSize="18sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hw_distance" android:textColor="#FF85858E" android:textSize="10sp" android:letterSpacing="0.08" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF4F4F5" android:textSize="18sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hw_time" android:textColor="#FF85858E" android:textSize="10sp" android:letterSpacing="0.08" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/top" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF4F4F5" android:textSize="18sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hw_top" android:textColor="#FF85858E" android:textSize="10sp" android:letterSpacing="0.08" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/lean" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFF4F4F5" android:textSize="18sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hw_max_lean" android:textColor="#FF85858E" android:textSize="10sp" android:letterSpacing="0.08" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
