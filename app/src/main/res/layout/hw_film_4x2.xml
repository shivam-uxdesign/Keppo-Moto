<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/hw_card" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hw_film_today" android:textColor="#FF69C8CB" android:textSize="11sp" android:letterSpacing="0.08" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#FFF4F4F5" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#FF8B8B93" android:textSize="12sp" />
    </LinearLayout>
    <ImageView android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/g0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:background="@drawable/hw_chip" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
        <ImageView android:id="@+id/g0_icon" android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/hw_tile_sel" android:padding="5dp" android:src="@drawable/hw_ic_camera" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/g0_where" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFF4F4F5" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/g0_shots" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF8B8B93" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/g1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:background="@drawable/hw_chip" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
        <ImageView android:id="@+id/g1_icon" android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/hw_tile_sel" android:padding="5dp" android:src="@drawable/hw_ic_tripod" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/g1_where" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFF4F4F5" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/g1_shots" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF8B8B93" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/hint" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#FF8B8B93" android:textSize="12sp" android:maxLines="2" />
        <LinearLayout android:id="@+id/start" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/hw_pill_white" android:gravity="center" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:contentDescription="@string/hw_start_ride">
            <ImageView android:layout_width="13dp" android:layout_height="13dp" android:src="@drawable/hw_ic_play" android:importantForAccessibility="no" />
            <TextView android:id="@+id/start_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="@string/hw_start_ride" android:textColor="#FF0A0A0B" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
