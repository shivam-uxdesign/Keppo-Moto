<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/hw_card" android:orientation="vertical" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:id="@+id/tile0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"  android:background="@drawable/hw_chip" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/lab0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:textColor="#FF85858E" android:textSize="10sp" android:letterSpacing="0.06" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/val0" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFF4F4F5" android:textSize="19sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tile1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="6dp" android:background="@drawable/hw_chip" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/lab1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:textColor="#FF85858E" android:textSize="10sp" android:letterSpacing="0.06" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/val1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFF4F4F5" android:textSize="19sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tile2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="6dp" android:background="@drawable/hw_chip" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/lab2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:textColor="#FF85858E" android:textSize="10sp" android:letterSpacing="0.06" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/val2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFF4F4F5" android:textSize="19sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/tile3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"  android:background="@drawable/hw_chip" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/lab3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:textColor="#FF85858E" android:textSize="10sp" android:letterSpacing="0.06" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/val3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFF4F4F5" android:textSize="19sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tile4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="6dp" android:background="@drawable/hw_chip" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/lab4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:textColor="#FF85858E" android:textSize="10sp" android:letterSpacing="0.06" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/val4" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFF4F4F5" android:textSize="19sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/tile5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginStart="6dp" android:background="@drawable/hw_chip" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/lab5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:textColor="#FF85858E" android:textSize="10sp" android:letterSpacing="0.06" android:fontFamily="sans-serif-medium" android:maxLines="1" />
            <TextView android:id="@+id/val5" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFF4F4F5" android:textSize="19sp" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <ViewFlipper android:id="@+id/flip_text" android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginTop="8dp" android:inAnimation="@anim/hw_fade_in" android:outAnimation="@anim/hw_fade_out" />
</LinearLayout>
